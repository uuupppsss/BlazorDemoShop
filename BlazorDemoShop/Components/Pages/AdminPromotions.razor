@page "/admin/promotions"
@attribute [Authorize(Roles = "admin")]

@using BlazorDemoShop.Components.Layout

@inject PromotionsService PromotionsService
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Акции</h3>

<table class="table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Товар</th>
        <th>Скидка</th>
        <th>Начало</th>
        <th>Конец</th>
        <th></th>
    </tr>
    </thead>

    <tbody>
    @foreach (var promotion in _promotions)
    {
        <tr>
            <td>@promotion.Id</td>
            <td>@promotion.ProductName</td>
            <td>@promotion.Discount%</td>
            <td>@promotion.StartDate.ToShortDateString()</td>
            <td>@promotion.EndDate.ToShortDateString()</td>

            <td>
                    <NavLink class="btn btn-warning"
                             href="@($"/admin/products/{promotion.ProductId}/promotion")">
                        Изменить
                    </NavLink>

                <button class="btn btn-danger btn-sm"
                        @onclick="()=>OpenDeleteModal(promotion.Id)">
                    Удалить
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (_promToDeleteId != 0)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <ConfirmDialog IsVisible="@showDeleteModal"
                       Title="Подтверждение удаления"
                       Message="Удалить акцию?"
                       ConfirmText="Удалить"
                       CancelText="Отмена"
                       OnConfirm="Delete"
                       OnCancel="CloseDeleteModal" />

    </div>
}

@code {
    private int _promToDeleteId = 0;
    private bool showDeleteModal = false;
    private List<PromotionDto> _promotions = [];

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var accessToken = authState.User.FindFirst(AuthClaimTypes.AccessToken)?.Value;

        _promotions = await PromotionsService.GetAll(accessToken);

        StateHasChanged();
    }

    private void OpenDeleteModal(int id)
    {
        _promToDeleteId = id;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        _promToDeleteId = 0;
        showDeleteModal = false;
    }

    private async Task Delete()
    {
        if (_promToDeleteId > 0)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var accessToken = authState.User.FindFirst(AuthClaimTypes.AccessToken)?.Value;

            await PromotionsService.Delete(_promToDeleteId, accessToken);
            CloseDeleteModal();

            await Load();
        }
    }
}