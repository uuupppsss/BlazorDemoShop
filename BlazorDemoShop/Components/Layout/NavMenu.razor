@inject ApiAuthClientService ApiAuthClient
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Магазин посуды</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <AuthorizeView>
            <Authorized Context="auth">
            
                        
                @if (auth.User.IsInRole("user"))
                {
                    <div class="sidebar">
                        <nav class="nav flex-column">
                            <div class="nav-item px-3">
                                <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">
                                    <i class="bi bi-house-door"></i>
                                    <span>Главная</span>
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink href="/products" class="nav-link">
                                    <i class="bi bi-grid"></i>
                                    <span>Каталог</span>
                                </NavLink>
                            </div>
                    <div class="nav-item px-3">
                            <NavLink href="/cart" class="nav-link">
                                <i class="bi bi-cart3"></i>
                                <span>Корзина</span>
                            </NavLink>
                            </div>

                            <div class="nav-item px-3">
                            <NavLink href="/orders" class="nav-link">
                                <i class="bi bi-box-seam"></i>
                                <span>Мои заказы</span>
                            </NavLink>
                            </div>

                            <div class="nav-item px-3">
                                <NavLink href="/saved" class="nav-link">
                                    <i class="bi bi-heart"></i>
                                    <span>Избранное</span>
                                </NavLink>
                            </div>

                            <div class="nav-item px-3">
                            <NavLink class="nav-link" href="profile">
                                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @auth.User.Identity?.Name
                            </NavLink>

                                <div class="nav-item px-3">
                                    <button type="button" class="nav-link btn btn-link text-start w-100" @onclick="() => LogoutAsync(auth.User)">
                                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Выйти
                                    </button>
                                </div>
                            </div>
                    </nav>
            </div>    
                }
                    

                @if (auth.User.IsInRole("admin"))
                {
                    <div class="sidebar admin-sidebar">

                        <div class="sidebar-header">
                            <h4>Панель управления</h4>
                        </div>

                        <nav class="nav flex-column">

                            <div class="menu-section">
                                <div class="menu-title">
                                    <i class="bi bi-box"></i>
                                    <span>Товары</span>
                                </div>
                                <NavLink href="/products" class="nav-link submenu">
                                    <i class="bi bi-grid"></i>
                                    <span>Каталог</span>
                                </NavLink>

                                <NavLink href="/admin/products/create" class="nav-link submenu">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Добавить товар</span>
                                </NavLink>

                                <NavLink href="/admin/tags-management" class="nav-link submenu">
                                    <i class="bi bi-tags"></i>
                                    <span>Теги</span>
                                </NavLink>
                            </div>

                            <div class="menu-section">
                                <div class="menu-title">
                                    <i class="bi bi-cart-check"></i>
                                    <span>Заказы</span>
                                </div>

                                <NavLink href="/admin/orders" class="nav-link submenu">
                                    <i class="bi bi-list-check"></i>
                                    <span>Все заказы</span>
                                </NavLink>
                            </div>

                            <NavLink href="/admin/banners" class="nav-link">
                                <i class="bi bi-image"></i>
                                <span>Баннеры</span>
                            </NavLink>

                            @* <NavLink href="/admin/reviews" class="nav-link">
                                <i class="bi bi-star"></i>
                                <span>*Отзывы</span>
                            </NavLink> *@

                            <NavLink href="/admin/reports" class="nav-link">
                                <i class="bi bi-bar-chart"></i>
                                <span>Отчеты</span>
                            </NavLink>

                            <NavLink href="/admin/promotions" class="nav-link">
                                <span>Акции</span>
                            </NavLink>

                            @* <NavLink href="/admin/settings" class="nav-link">
                                <i class="bi bi-gear"></i>
                                <span>*Настройки</span>
                            </NavLink> *@

                            <div class="nav-item px-3">
                                <button type="button" class="nav-link btn btn-link text-start w-100" @onclick="() => LogoutAsync(auth.User)">
                                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Выйти
                                </button>
                            </div>

                        </nav>
                    </div>
                }

                

                
            </Authorized>
            <NotAuthorized>
                    <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Главная
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/products">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Каталог
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Войти
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        <span class="bi bi-person-plus" aria-hidden="true"></span> Регистрация
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        @if (!string.IsNullOrWhiteSpace(_logoutError))
        {
            <div class="px-3 mt-2 small logout-error">@_logoutError</div>
        }
    </nav>
</div>

@code {
    private string? _logoutError;

    private async Task LogoutAsync(ClaimsPrincipal user)
    {
        _logoutError = null;

        try
        {
            var token = user.FindFirst(AuthClaimTypes.AccessToken)?.Value;
            await ApiAuthClient.LogoutAsync(token);
        }
        catch
        {
            
        }

        try
        {
            // очищаем локальную auth-cookie
            await JsRuntime.InvokeVoidAsync("authSession.signOut");
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch
        {
            _logoutError = "Не удалось завершить локальную сессию. ";
        }
    }
}

