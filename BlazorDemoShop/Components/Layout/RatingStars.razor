<div class="rating-stars">
    @for (int i = 1; i <= 5; i++)
    {
        if (i <= Value)
        {
            <span class="star filled">★</span>
        }
        else
        {
            <span class="star">☆</span>
        }
    }
</div>

@code {
    [Parameter]
    public double Value { get; set; }
}
